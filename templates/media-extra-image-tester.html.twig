            />
        </svg>
        <span>Facebook</span>
        </div>
        <span class="pc-spec" data-fb-spec>Link share · 1.91:1</span>
    </header>
    <div class="pc-body fb-body">
        <div class="fb-post">
        <div class="fb-meta">
            <div class="fb-avatar"></div>
            <div>
            <div class="fb-name">Your Page</div>
            <div class="fb-time">2h · 🌐</div>
            </div>
        </div>
