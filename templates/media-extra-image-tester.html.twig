<section class="hero">
<h1>
    See exactly how your OG image renders<br />
    <span class="muted">on Facebook, LinkedIn, X, Slack & iMessage.</span>
</h1>
<p class="lede">
    Drop an image, paste a URL, or use the demo. Toggle safe-area
    overlays, switch aspect ratios, and watch every platform crop, zoom
    and letterbox your asset in real time.
</p>
</section>

<!-- CONTROL DECK -->
<section class="deck">
<div class="deck-grid">
    <!-- Source -->
    {# <div class="panel">
    <div class="panel-head">
        <span class="step">01</span>
        <h2>Source image</h2>
    </div>
    <div
        id="dropzone"
        class="dropzone"
        tabindex="0"
        role="button"
        aria-label="Upload image"
    >
        <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        >
        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
        <polyline points="17 8 12 3 7 8" />
        <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
        <span class="dz-title">Drag & drop</span>
        <span class="dz-sub">PNG, JPG, WebP — or click to browse</span>
        <input
        type="file"
        id="fileInput"
        accept="image/*"
        hidden
        />
    </div>
    <div class="url-row">
        <input
        type="url"
        id="urlInput"
        placeholder="…or paste image URL"
        autocomplete="off"
        value="{{ image_url }}"
        />
        <button id="urlLoadBtn" class="btn">Load</button>
    </div>
    <div class="sample-row">
        <span class="micro-label">Try a sample:</span>
        <button class="chip" data-sample="gradient">Gradient</button>
        <button class="chip" data-sample="photo">Photo</button>
        <button class="chip" data-sample="text">Text-heavy</button>
    </div>
    </div> #}

    <!-- Variant -->
    <div class="panel">
    <div class="panel-head">
        <h2>{{ image_styles_sub_heading }}</h2>
    </div>
    <div class="variant-grid" role="radiogroup" aria-label="Aspect variants">
        <!-- buttons injected by JS -->
        {% for variant_id, variant in variants %}
            <button class="variant-btn" type="button" data-id="{{ variant_id }}" data-image-url="{{ variant.image_url }}">
                <span class="vb-label">
                    <span class="vb-name">{{ variant.label }}</span>
                </span>
            </button>
        {% endfor %}
    </div>
    {# <div class="variant-meta" id="variantMeta"></div> #}
    <div class="src-meta" id="srcMeta">
        <span class="muted">No image loaded</span>
    </div>
    </div>

    <!-- Overlays -->
    <div class="panel">
    <div class="panel-head">
        <h2>{{ 'Overlays'|t }}</h2>
    </div>
    <div class="toggle-list">
        <label class="toggle">
        <input type="checkbox" id="tgSafe" checked />
        <span class="dot" style="--c: var(--ok)"></span>
        <span>Safe text zone</span>
        </label>
        <label class="toggle">
        <input type="checkbox" id="tgCrop" checked />
        <span class="dot" style="--c: var(--warn)"></span>
        <span>Mobile crop danger zones</span>
        </label>
        <label class="toggle">
        <input type="checkbox" id="tgGrid" />
        <span class="dot" style="--c: var(--accent)"></span>
        <span>Rule-of-thirds grid</span>
        </label>
        <label class="toggle">
        <input type="checkbox" id="tgCenter" />
        <span class="dot" style="--c: var(--accent)"></span>
        <span>Center crosshair</span>
        </label>
        <label class="toggle">
        <input type="checkbox" id="tgLabels" checked />
        <span class="dot" style="--c: var(--text-muted)"></span>
        <span>Dimension labels</span>
        </label>
    </div>
    {# <button id="exportBtn" class="btn primary block">
        <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        >
        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        Export annotated PNG
    </button> #}
    </div>
</div>
</section>

<!-- MASTER CANVAS -->
<section class="master">
<div class="section-head">
    <h2>Master canvas</h2>
    <span class="micro-label" id="masterDimLabel">—</span>
</div>
<div class="master-stage" id="masterStage">
    <canvas id="masterCanvas" aria-label="Master OG image preview"></canvas>
</div>
</section>

<!-- PLATFORM PREVIEWS -->
<section class="previews">
<div class="section-head">
