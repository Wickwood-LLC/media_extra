{% if user.hasPermission('see og image tester reference specs') %}
<!-- SPECS REFERENCE -->
<section class="specs" id="specs">
<div class="section-head">
    <h2>Reference specs</h2>
    <span class="micro-label">Verified against current platform docs (2025–2026)</span>
</div>
<div class="specs-grid">
    <div class="spec-card">
    <div class="spec-head">
        <h3>Facebook</h3>
        <span class="badge">Link share</span>
    </div>
    <dl>
        <div><dt>Recommended</dt><dd>1200 × 630 px</dd></div>
        <div><dt>Aspect</dt><dd>1.91 : 1</dd></div>
        <div><dt>Minimum</dt><dd>600 × 315 px</dd></div>
        <div><dt>Max file</dt><dd>8 MB</dd></div>
        <div><dt>Format</dt><dd>JPG, PNG</dd></div>
        <div><dt>Safe area</dt><dd>Inner 90% — avoid outer 5% on each side</dd></div>
    </dl>
    <p class="spec-note">
        Mobile crops slightly tighter on portrait devices. Center your subject.
        Source:
        <a
        href="https://birdeye.com/blog/facebook-post-size/"
        target="_blank"
        rel="noopener"
        >Birdeye 2026 guide</a
        >.
    </p>
    </div>

    <div class="spec-card">
    <div class="spec-head">
        <h3>LinkedIn</h3>
        <span class="badge">Link preview</span>
    </div>
    <dl>
        <div><dt>Recommended</dt><dd>1200 × 627 px</dd></div>
        <div><dt>Aspect</dt><dd>1.91 : 1</dd></div>
        <div><dt>Square option</dt><dd>1200 × 1200 px</dd></div>
        <div><dt>Max file</dt><dd>5 MB</dd></div>
        <div><dt>Format</dt><dd>JPG, PNG</dd></div>
        <div><dt>Safe area</dt><dd>Center 80% — text/logo can crop on mobile</dd></div>
    </dl>
    <p class="spec-note">
        1200×627 is safest for link unfurls; 1200×1200 wins on mobile feed.
        Source:
        <a
        href="https://postline.ai/blog/2/linkedin-share-image-size"
        target="_blank"
        rel="noopener"
        >Postline.ai</a
        >.
    </p>
    </div>

    <div class="spec-card">
    <div class="spec-head">
        <h3>X / Twitter</h3>
        <span class="badge">Summary large</span>
    </div>
    <dl>
        <div><dt>Recommended</dt><dd>1200 × 675 px (16:9)</dd></div>
        <div><dt>Larger option</dt><dd>1600 × 900 px</dd></div>
        <div><dt>Square posts</dt><dd>1200 × 1200 px (multi-image)</dd></div>
        <div><dt>Min display</dt><dd>600 × 335 px</dd></div>
        <div><dt>Max file</dt><dd>5 MB photos</dd></div>
        <div><dt>Format</dt><dd>JPG, PNG, WebP, GIF</dd></div>
    </dl>
    <p class="spec-note">
        16:9 expands without cropping in timeline. Source:
        <a
        href="https://postfa.st/sizes/x/posts"
        target="_blank"
        rel="noopener"
        >PostFast 2026</a
        >.
    </p>
    </div>

    <div class="spec-card">
    <div class="spec-head">
        <h3>Slack & Discord</h3>
        <span class="badge">Unfurl</span>
    </div>
    <dl>
        <div><dt>Slack thumb</dt><dd>Re-uses og:image; renders ~360px wide</dd></div>
        <div><dt>Discord embed</dt><dd>Up to ~400px wide, full aspect retained</dd></div>
        <div><dt>Recommend</dt><dd>1200 × 630 px works for both</dd></div>
        <div><dt>Max file</dt><dd>≤ 5 MB recommended</dd></div>
    </dl>
    <p class="spec-note">
        Both platforms read standard
        <code>og:image</code> tags — no separate spec required.
    </p>
    </div>

    <div class="spec-card">
    <div class="spec-head">
        <h3>iMessage</h3>
        <span class="badge">Rich link</span>
    </div>
    <dl>
        <div><dt>Thumb shape</dt><dd>Square crop from center</dd></div>
        <div><dt>Recommend</dt><dd>Provide square or center-safe 1200×630</dd></div>
        <div><dt>Reads</dt><dd>og:image + apple-touch-icon</dd></div>
    </dl>
    <p class="spec-note">
        Apple's Smart Link card center-crops to a square. Keep the subject
        dead-center.
    </p>
    </div>

    <div class="spec-card">
    <div class="spec-head">
        <h3>Required meta tags</h3>
        <span class="badge">Implementation</span>
    </div>
    <pre class="codeblock"><code>&lt;meta property="og:image" content="https://yoursite.com/og.png"&gt;
&lt;meta property="og:image:width" content="1200"&gt;
&lt;meta property="og:image:height" content="630"&gt;
&lt;meta property="og:image:alt" content="Descriptive alt text"&gt;
&lt;meta name="twitter:card" content="summary_large_image"&gt;
&lt;meta name="twitter:image" content="https://yoursite.com/og.png"&gt;</code></pre>
</div>
</div>
</section>
{% endif %}